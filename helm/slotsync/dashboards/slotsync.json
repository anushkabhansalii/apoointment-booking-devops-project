      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(slotsync_appointments_created_total{namespace=\"$namespace\"}[24h]))",
          "legendFormat": ""
