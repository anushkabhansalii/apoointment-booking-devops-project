# Copy to terraform.tfvars (git-ignored) and adjust.
# AWS credentials do NOT go here - use `aws configure` or environment variables.

region             = "ap-south-1"
project            = "slotsync"
environment        = "demo"
kubernetes_version = "1.34"

vpc_cidr           = "10.20.0.0/16"
az_count           = 2
single_nat_gateway = true

node_instance_types = ["t3.large"]
node_capacity_type  = "ON_DEMAND"
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4

# Lock the Kubernetes API down to your own public IP (curl -s https://checkip.amazonaws.com)
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# admin_principal_arns = ["arn:aws:iam::123456789012:user/teammate"]
